<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>EveryonePicks</AssemblyName>
    <RootNamespace>EveryonePicks</RootNamespace>
    <Version>0.5.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169</NoWarn>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Debug visual tooling (F10 reveal simulator) is compiled in ONLY for local builds.
       Publish with:  dotnet build -c Release -p:EpDebug=false  -->
  <PropertyGroup Condition="'$(EpDebug)' != 'false'">
    <DefineConstants>$(DefineConstants);EP_DEBUG</DefineConstants>
  </PropertyGroup>

  <!-- Where the game and your mod profile live. Both can be overridden without editing this
       file: put them in Local.props (git-ignored), or pass them on the command line, e.g.
         dotnet build -c Release -p:Profile="D:\path\to\profile"
       The defaults are the standard Steam and Thunderstore locations. -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ROUNDS\Rounds_Data\Managed</GameManaged>
    <Profile Condition="'$(Profile)' == ''">$(AppData)\Thunderstore Mod Manager\DataFolder\ROUNDS\profiles\Default</Profile>
  </PropertyGroup>

  <!-- Without the game installed (CI, or a machine without ROUNDS) the game's own assemblies are
       replaced by the reference stubs in refs/ and the Unity modules package, and the mod-side
       DLLs come from deps/ (tools/fetch-deps.sh). Force either way with -p:UseRefStubs=true|false. -->
  <PropertyGroup>
    <UseRefStubs Condition="'$(UseRefStubs)' == '' and !Exists('$(GameManaged)\Assembly-CSharp.dll')">true</UseRefStubs>
    <Profile Condition="'$(UseRefStubs)' == 'true' and !Exists('$(Profile)\BepInEx\core\BepInEx.dll')">$(MSBuildThisFileDirectory)..\deps</Profile>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseRefStubs)' != 'true'">
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(GameManaged)\UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Photon3Unity3D"><HintPath>$(GameManaged)\Photon3Unity3D.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonUnityNetworking"><HintPath>$(GameManaged)\PhotonUnityNetworking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonRealtime"><HintPath>$(GameManaged)\PhotonRealtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseRefStubs)' == 'true'">
    <PackageReference Include="UnityEngine.Modules" Version="2018.4.34" IncludeAssets="compile" PrivateAssets="all" />
    <ProjectReference Include="..\refs\Assembly-CSharp\Assembly-CSharp.csproj" Private="false" />
    <ProjectReference Include="..\refs\PhotonUnityNetworking\PhotonUnityNetworking.csproj" Private="false" />
    <ProjectReference Include="..\refs\PhotonRealtime\PhotonRealtime.csproj" Private="false" />
    <ProjectReference Include="..\refs\Photon3Unity3D\Photon3Unity3D.csproj" Private="false" />
    <ProjectReference Include="..\refs\UnityEngine.UI\UnityEngine.UI.csproj" Private="false" />
    <ProjectReference Include="..\refs\Unity.TextMeshPro\Unity.TextMeshPro.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(Profile)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Profile)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnboundLib"><HintPath>$(Profile)\BepInEx\plugins\willis81808-UnboundLib\UnboundLib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
