<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the couch board's pure logic. The files are compiled in from src/Couch, which
       has no Unity or game types, so this runs anywhere with a .NET SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Couch\*.cs" />
  </ItemGroup>
</Project>
